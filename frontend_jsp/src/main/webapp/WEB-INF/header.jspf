<%@ page isELIgnored="true" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%-- Récupération du rôle (pour masquer les menus selon l’utilisateur) --%>
<%
  String role = (String) session.getAttribute("userRole");
  if (role == null) role = "VILLAGEOIS";
%>
<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EclectriDB — Gestion Énergie</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
<div class="app-layout">

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="navbar-brand">
      <div class="logo-icon">⚡</div>
      Electri<span>DB</span>
    </div>
    <div class="navbar-center">
      <div class="status-dot"></div>
      <span id="server-status">Connecté au serveur</span>
    </div>
    <div class="navbar-actions">
      <button class="btn-icon" id="mobile-menu-toggle" title="Menu" style="display:none">☰</button>
      <button class="btn-icon" id="theme-toggle" title="Changer le thème">🌙</button>
      <div class="user-avatar" title="Mon compte">?</div>
    </div>
  </nav>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <!-- User Info -->
    <div style="padding:12px;margin-bottom:16px;background:var(--bg-secondary);border-radius:var(--radius);border:1px solid var(--border);">
      <div style="display:flex;align-items:center;gap:10px;">
        <div class="user-avatar" style="width:40px;height:40px;font-size:16px;">?</div>
        <div>
          <div style="font-weight:600;font-size:0.875rem;" id="current-username">Utilisateur</div>
          <span class="badge badge-blue" id="current-role">RESPONSABLE</span>
        </div>
      </div>
    </div>

    <!-- Navigation principale -->
    <div class="sidebar-section">
      <div class="sidebar-label">Navigation</div>
      <a href="/frontend_jsp/dashboard.jsp" class="nav-item ${param.activePage == 'dashboard' ? 'active' : ''}">
        <span class="nav-icon">📊</span> Tableau de bord
      </a>

      <a href="/frontend_jsp/demandes.jsp" class="nav-item ${param.activePage == 'demandes' ? 'active' : ''}">
        <span class="nav-icon">⚡</span> Demandes Énergie
        <span class="nav-badge" id="badge-demandes">0</span>
      </a>

      <% if ("RESPONSABLE".equals(role) || "ADMIN".equals(role)) { %>
        <a href="/frontend_jsp/foyers.jsp" class="nav-item ${param.activePage == 'foyers' ? 'active' : ''}">
          <span class="nav-icon">🏠</span> Foyers
        </a>
        <a href="/frontend_jsp/batteries.jsp" class="nav-item ${param.activePage == 'batteries' ? 'active' : ''}">
          <span class="nav-icon">🔋</span> Batteries
        </a>
      <% } %>
    </div>

    <!-- Système -->
    <div class="sidebar-section">
      <div class="sidebar-label">Système</div>
      <% if ("RESPONSABLE".equals(role) || "ADMIN".equals(role)) { %>
        <a href="/frontend_jsp/allocation.jsp" class="nav-item ${param.activePage == 'allocation' ? 'active' : ''}">
          <span class="nav-icon">🎯</span> Allocation
        </a>
        <a href="/frontend_jsp/rapports.jsp" class="nav-item ${param.activePage == 'rapports' ? 'active' : ''}">
          <a href="/frontend_jsp/comparison.jsp" class="nav-item">
            <span class="nav-icon">📊</span> Comparison
          </a>
          <a href="/frontend_jsp/network.jsp" class="nav-item">
            <span class="nav-icon">🌐</span> Réseau
          </a>
          <span class="nav-icon">📋</span> Rapports
        </a>
        <a href="/frontend_jsp/utilisateurs.jsp" class="nav-item ${param.activePage == 'utilisateurs' ? 'active' : ''}">
          <span class="nav-icon">👥</span> Utilisateurs
        </a>
      <% } %>
    </div>

    <!-- Actions -->
    <div class="sidebar-section" style="margin-top:auto;">
      <div class="sidebar-label">Compte</div>
      <button class="nav-item" id="btn-logout" style="width:100%;text-align:left;">
        <span class="nav-icon">🚪</span> Déconnexion
      </button>
    </div>
  </aside>
