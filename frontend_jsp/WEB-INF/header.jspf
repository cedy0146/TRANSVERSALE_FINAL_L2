<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EclectriDB — ${param.pageTitle != null ? param.pageTitle : 'Gestion Énergie'}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
<div class="app-layout">

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="navbar-brand">
      <div class="logo-icon">⚡</div>
      Electri<span>DB</span>
    </div>
    <div class="navbar-center">
      <div class="status-dot"></div>
      <span id="server-status">Connecté au serveur</span>
    </div>
    <div class="navbar-actions">
      <button class="btn-icon" id="mobile-menu-toggle" title="Menu" style="display:none">☰</button>
      <button class="btn-icon" id="theme-toggle" title="Changer le thème">🌙</button>
      <div class="user-avatar" title="Mon compte">?</div>
    </div>
  </nav>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <!-- User Info -->
    <div style="padding:12px;margin-bottom:16px;background:var(--bg-secondary);border-radius:var(--radius);border:1px solid var(--border);">
      <div style="display:flex;align-items:center;gap:10px;">
        <div class="user-avatar" style="width:40px;height:40px;font-size:16px;">?</div>
        <div>
          <div style="font-weight:600;font-size:0.875rem;" id="current-username">Utilisateur</div>
          <span class="badge badge-blue" id="current-role">RESPONSABLE</span>
        </div>
      </div>
    </div>

    <!-- Navigation principale -->
    <div class="sidebar-section">
      <div class="sidebar-label">Navigation</div>
      <a href="${pageContext.request.contextPath}/dashboard.jsp" class="nav-item ${param.activePage == 'dashboard' ? 'active' : ''}">
        <span class="nav-icon">📊</span> Tableau de bord
      </a>
      <a href="${pageContext.request.contextPath}/foyers.jsp" class="nav-item ${param.activePage == 'foyers' ? 'active' : ''}">
        <span class="nav-icon">🏠</span> Foyers
      </a>
      <a href="${pageContext.request.contextPath}/batteries.jsp" class="nav-item ${param.activePage == 'batteries' ? 'active' : ''}">
        <span class="nav-icon">🔋</span> Batteries
      </a>
      <a href="${pageContext.request.contextPath}/demandes.jsp" class="nav-item ${param.activePage == 'demandes' ? 'active' : ''}">
        <span class="nav-icon">⚡</span> Demandes Énergie
        <span class="nav-badge" id="badge-demandes">0</span>
      </a>
    </div>

    <!-- Système -->
    <div class="sidebar-section">
      <div class="sidebar-label">Système</div>
      <a href="${pageContext.request.contextPath}/allocation.jsp" class="nav-item ${param.activePage == 'allocation' ? 'active' : ''}">
        <span class="nav-icon">🎯</span> Allocation
      </a>
      <a href="${pageContext.request.contextPath}/rapports.jsp" class="nav-item ${param.activePage == 'rapports' ? 'active' : ''}">
        <span class="nav-icon">📋</span> Rapports
      </a>
      <a href="${pageContext.request.contextPath}/utilisateurs.jsp" class="nav-item ${param.activePage == 'utilisateurs' ? 'active' : ''}">
        <span class="nav-icon">👥</span> Utilisateurs
      </a>
    </div>

    <!-- Algorithmes -->
    <div class="sidebar-section">
      <div class="sidebar-label">Algorithmes</div>
      <a href="${pageContext.request.contextPath}/network.jsp" class="nav-item ${param.activePage == 'network' ? 'active' : ''}">
        <span class="nav-icon">🗺️</span> Réseau (Dijkstra)
      </a>
      <a href="${pageContext.request.contextPath}/comparison.jsp" class="nav-item ${param.activePage == 'comparison' ? 'active' : ''}">
        <span class="nav-icon">⚖️</span> Comparaison Algos
      </a>
    </div>

    <!-- Actions -->
    <div class="sidebar-section" style="margin-top:auto;">
      <div class="sidebar-label">Compte</div>
      <button class="nav-item" id="btn-logout" style="width:100%;text-align:left;">
        <span class="nav-icon">🚪</span> Déconnexion
      </button>
    </div>
  </aside>
